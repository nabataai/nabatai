rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    
    function isValidFileSize(maxSize) {
      return request.resource.size <= maxSize;
    }
    
    function isValidFileType(allowedTypes) {
      return request.resource.contentType in allowedTypes;
    }
    
    // Application documents
    match /applications/{applicationId}/{fileName} {
      
      // CV/Resume files
      match /cv/{file} {
        allow write: if isValidFileSize(10 * 1024 * 1024) && // 10MB
                        isValidFileType([
                          'application/pdf',
                          'application/msword',
                          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                        ]);
        allow read: if isAdmin();
      }
      
      // Cover letter files
      match /cover-letter/{file} {
        allow write: if isValidFileSize(10 * 1024 * 1024) && // 10MB
                        isValidFileType([
                          'application/pdf',
                          'application/msword',
                          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                        ]);
        allow read: if isAdmin();
      }
      
      // Portfolio files
      match /portfolio/{file} {
        allow write: if isValidFileSize(15 * 1024 * 1024) && // 15MB
                        isValidFileType([
                          'application/pdf',
                          'application/msword',
                          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                        ]);
        allow read: if isAdmin();
      }
      
      // Identity documents (highly sensitive - extra restrictions)
      match /identity/{file} {
        allow write: if isValidFileSize(5 * 1024 * 1024) && // 5MB
                        isValidFileType([
                          'image/jpeg',
                          'image/png',
                          'application/pdf'
                        ]);
        
        // Only admins with explicit permission can access
        allow read: if isAdmin();
        
        // Log all access attempts
        allow read: if isAdmin() && 
                       firestore.get(/databases/(default)/documents/auditLogs/$(request.auth.uid)).data.canAccessIdentityDocs == true;
      }
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
